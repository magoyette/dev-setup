#!/usr/bin/env bash
set -euo pipefail

if [[ $# -lt 2 ]]; then
  printf 'usage: dev-setup-ai-assistant-sandbox <launcher-name> <command> [args...]\n' >&2
  exit 2
fi

launcher="$1"
shift
command_path="$1"
shift

config_file="$HOME/.config/dev-setup/ai-assistant-sandbox.env"

if [[ -f "$config_file" ]]; then
  # shellcheck source=/dev/null
  source "$config_file"
fi

contains_word() {
  local needle="$1"
  local haystack="$2"

  [[ " $haystack " == *" $needle "* ]]
}

profile_var_suffix="$(printf '%s' "$launcher" | tr '[:lower:]-' '[:upper:]_')"
profile_var="DEV_SETUP_NONO_PROFILE_${profile_var_suffix}"
profile="${!profile_var:-$launcher}"

if [[ -v DEV_SETUP_NONO_ENABLED_LAUNCHERS ]]; then
  enabled_launchers="$DEV_SETUP_NONO_ENABLED_LAUNCHERS"
else
  enabled_launchers="opencode"
fi

if [[ -v DEV_SETUP_NONO_REQUIRED_LAUNCHERS ]]; then
  required_launchers="$DEV_SETUP_NONO_REQUIRED_LAUNCHERS"
else
  required_launchers="opencode"
fi

if ! contains_word "$launcher" "$enabled_launchers"; then
  exec "$command_path" "$@"
fi

if command -v nono.sh >/dev/null 2>&1; then
  sandbox_command=nono.sh
elif command -v nono >/dev/null 2>&1; then
  sandbox_command=nono
else
  sandbox_command=
fi

if [[ -n "$sandbox_command" ]]; then
  # Landlock cannot deny Herdr paths inside a broadly allowed /tmp.
  # Ignore inherited TMPDIR so every sandbox gets a private, narrow grant.
  TMPDIR="$(mktemp -d /tmp/dev-setup-ai.XXXXXXXXXX)"
  export TMPDIR
  # Hide the easy WSL interop path from sandboxed processes. Pathname Unix
  # socket connections are not mediated on stock WSL2 kernels, so the interop
  # sockets stay reachable; disabling interop in wsl.conf is the real
  # boundary (see docs/wsl-interop.md).
  unset WSL_INTEROP WSLENV
  # Grant the working directory up front at the profile workdir level instead
  # of prompting on every launch. Set DEV_SETUP_NONO_ALLOW_CWD=false to get
  # the interactive sharing prompt back.
  sandbox_args=(run --profile "$profile")
  if [[ "${DEV_SETUP_NONO_ALLOW_CWD:-true}" != "false" ]]; then
    sandbox_args+=(--allow-cwd)
  fi
  # Pre-flight the launch with a dry run. Linux Landlock cannot enforce a
  # deny rule inside an allowed directory, so nono refuses to start when a
  # directory granted at launch (the --allow-cwd working directory, or
  # NONO_ALLOW) contains a denied path. Catch that here so the conflict can
  # be explained in launcher terms; any other pre-flight failure still
  # falls through to nono's own report. The dry run adds milliseconds.
  preflight_log="$(mktemp)"
  if "$sandbox_command" "${sandbox_args[@]}" --dry-run -- true >"$preflight_log" 2>&1; then
    preflight_status=0
  else
    preflight_status=$?
  fi
  if (( preflight_status != 0 )); then
    if grep -Eqi 'deny-overlap|overlaps allowed parent' "$preflight_log"; then
      remedies=()
      if [[ "${DEV_SETUP_NONO_ALLOW_CWD:-true}" != "false" ]]; then
        remedies+=('  - launch from a narrower working directory that contains no denied paths')
      fi
      if [[ -n "${NONO_ALLOW:-}" ]]; then
        remedies+=('  - unset or narrow NONO_ALLOW')
      fi
      if [[ ${#remedies[@]} -eq 0 ]]; then
        remedies+=('  - adjust the profile grants or deny rules (see docs/nono-sandbox.md)')
      fi
      {
        printf 'dev-setup-ai-assistant-sandbox: nono refused to start the %s sandbox because a directory granted to this launch contains paths the sandbox profile denies. Linux Landlock cannot enforce a deny rule inside an allowed directory, so nono refuses to run rather than silently drop the denies.\n' "$launcher"
        printf '\n'
        printf 'Grants in effect for this launch:\n'
        if [[ "${DEV_SETUP_NONO_ALLOW_CWD:-true}" != "false" ]]; then
          printf '  - working directory: %s (--allow-cwd)\n' "$PWD"
        fi
        if [[ -n "${NONO_ALLOW:-}" ]]; then
          printf '  - NONO_ALLOW: %s\n' "$NONO_ALLOW"
        fi
        printf '\n'
        printf 'Fix by removing the overlap:\n'
        printf '%s\n' "${remedies[@]}"
        printf '\n'
        printf 'The profile denies sensitive paths such as credentials and the Herdr and Docker sockets. See docs/nono-sandbox.md in the dev-setup repository. nono report follows:\n'
        printf '\n'
      } >&2
    fi
    cat "$preflight_log" >&2
    rm -f "$preflight_log"
    exit "$preflight_status"
  fi
  rm -f "$preflight_log"
  # Do not exec into nono. Its supervisor runs non-dumpable (PR_SET_DUMPABLE(0)),
  # which hides the pane's foreground environment from Herdr's process
  # detection: the HERDR_AGENT=opencode hint exported by the opencode wrapper
  # becomes unreadable and Herdr attributes the pane to no agent at all. Run
  # nono as a foreground child so this launcher process stays the foreground
  # process-group leader and keeps a readable environment with the hint.
  # Ignore the terminal signals while waiting: nono is a foreground group
  # member, receives them itself, and decides when the session ends.
  trap '' INT TERM
  set +e
  "$sandbox_command" "${sandbox_args[@]}" -- "$command_path" "$@"
  sandbox_status=$?
  set -e
  exit "$sandbox_status"
fi

if ! contains_word "$launcher" "$required_launchers"; then
  exec "$command_path" "$@"
fi

printf 'dev-setup-ai-assistant-sandbox: nono.sh is required for %s but was not found\n' "$launcher" >&2
exit 127
