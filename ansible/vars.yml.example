---
git_user_name: "Your Name"
git_user_email: "you@example.com"
git_core_editor: "emacsclient -nw"
shell_editor: "emacsclient -nw" # sets $EDITOR and $VISUAL
bat_theme: "OneHalfDark"
herdr_theme: "one-dark"
delta_syntax_theme: "OneHalfDark"
hunk_theme: "one-dark-pro"
ccstatusline_theme: "onedark"
install_git_aliases: true
ai_assistants_sandbox_writable_roots: []
ai_assistants_sandbox_allowed_hosts:
  # Whitelist ChatGPT for Claude Code Codex skills
  - chatgpt.com
  - ab.chatgpt.com
ai_assistants_mcps:
  - context7
  - grep
# Opt-in: disable Windows interop for this distribution. Requires wsl --shutdown
# after provisioning; see docs/wsl-interop.md for the impact analysis.
wsl_disable_interop: false
pyenv_version: "v2.5.3"
uv_version: "0.9.21"
python_version: "3.13.12"
playbooks_in_main_playbook:
  - core
  - python
  - starship
  - node
  - ai-assistants
  - emacs
playwright_browsers:
  - chrome
